# Copy this file to .env.local to override any value. Optional:
# src/config/site.ts already contains the $MSPIKE contract address.
NEXT_PUBLIC_TOKEN_ADDRESS=

# Public site URL (used for social share images), e.g. https://mspike.xyz
NEXT_PUBLIC_SITE_URL=

# Reown (WalletConnect) project ID for the Connect Wallet modal. Optional:
# src/config/site.ts already contains the default project ID.
NEXT_PUBLIC_REOWN_PROJECT_ID=
